{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "regions": ["gru1"],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    }
  ],
  "crons": [
    {
      "path": "/api/revalidate?tag=products",
      "schedule": "schedule": "0 12 * * *"
    }
  ]
}
